{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TinyD Canonical Control Model",
  "version": "1.1.0",
  "sourceOfTruth": "repository",
  "entityTypes": ["requirement","task","dependency","control","test","execution","event","evidence","verification","finding","release_gate"],
  "truthLevels": ["DEFINED","IMPLEMENTED","TESTED","EXECUTED","EVIDENCED","VERIFIED","CURRENT","RELEASEABLE"],
  "derivedStates": ["PLANNED","READY","DISPATCHED","RUNNING","SUCCEEDED","FAILED","TIMED_OUT","CANCELLED","BLOCKED","STALE","INVALID","PARTIAL","VERIFIED","RELEASE_ALLOWED","RELEASE_BLOCKED"],
  "invariants": [
    {"id":"C001","rule":"every_requirement_has_owner"},
    {"id":"C002","rule":"every_required_task_maps_to_requirement"},
    {"id":"C003","rule":"every_required_task_declares_dependencies"},
    {"id":"C004","rule":"ready_task_has_no_incomplete_required_dependency"},
    {"id":"C005","rule":"tested_requirement_has_required_test"},
    {"id":"C006","rule":"passing_test_has_execution_record"},
    {"id":"C007","rule":"authoritative_execution_has_execution_id"},
    {"id":"C008","rule":"evidence_references_execution"},
    {"id":"C009","rule":"evidence_records_source_revision"},
    {"id":"C010","rule":"verification_references_valid_evidence"},
    {"id":"C011","rule":"source_change_invalidates_dependent_verification"},
    {"id":"C012","rule":"releaseable_requires_all_mandatory_controls"},
    {"id":"C013","rule":"planner_only_schedules_ready_tasks"},
    {"id":"C014","rule":"scoreboard_only_displays_evaluated_repository_state"},
    {"id":"C015","rule":"manual_status_cannot_override_failed_predicate"}
  ],
  "verification": {
    "requiredPredicates": ["requirement_exists","implementation_complete","dependencies_satisfied","required_tests_exist","required_tests_pass","execution_exists","evidence_exists","evidence_valid","evidence_matches_source","no_blocking_findings"]
  },
  "readiness": {
    "requiredPredicates": ["task_exists","dependencies_exist","all_dependencies_satisfied","required_inputs_available","no_blocking_policy","task_not_stale"]
  },
  "release": {
    "requiredPredicates": ["all_required_requirements_verified","all_required_tests_pass","no_blocking_dependencies","no_required_evidence_missing","no_required_evidence_stale","no_unresolved_critical_findings"]
  },
  "transitions": [
    {"from":"DEFINED","to":"IMPLEMENTED","requires":["implementation_artifact_exists","requirement_mapping_exists"]},
    {"from":"IMPLEMENTED","to":"TESTED","requires":["required_test_exists","test_targets_implementation"]},
    {"from":"TESTED","to":"EXECUTED","requires":["execution_exists","execution_passed"]},
    {"from":"EXECUTED","to":"EVIDENCED","requires":["evidence_exists","evidence_references_execution","source_revision_recorded"]},
    {"from":"EVIDENCED","to":"VERIFIED","requires":["evidence_valid","evidence_covers_requirement","evidence_matches_source"]},
    {"from":"VERIFIED","to":"CURRENT","requires":["source_revision_unchanged","dependencies_unchanged"]},
    {"from":"CURRENT","to":"RELEASEABLE","requires":["all_required_requirements_verified","all_required_tests_pass","no_blocking_findings","current_source_proven"]}
  ],
  "invalidStates": [
    {"id":"INVALID-001","when":"task_complete_and_dependency_incomplete"},
    {"id":"INVALID-002","when":"requirement_tested_without_required_test"},
    {"id":"INVALID-003","when":"verification_without_evidence"},
    {"id":"INVALID-004","when":"evidence_source_revision_differs_from_current"},
    {"id":"INVALID-005","when":"releaseable_with_blocking_finding"}
  ],
  "releaseGate": {"state":"RELEASEABLE","failClosed":true,"manualOverrideAllowed":false,"requires":["all_required_requirements_verified","all_required_tests_pass","required_evidence_valid","no_blocking_findings","current_source_proven"]}
}
